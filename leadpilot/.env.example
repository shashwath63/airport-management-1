# Copy to .env (or set these in your hosting dashboard)

# ---- Required ----
ADMIN_PASSWORD=change-me-to-something-long
PUBLIC_URL=https://your-domain.com      # used in embed codes and demo links

# ---- AI engine: pick ONE (the first key found is used; no key = free demo mode) ----
# FREE options (no credit card needed):
GROQ_API_KEY=                           # free: https://console.groq.com/keys  (fast Llama models, recommended start)
GEMINI_API_KEY=                         # free: https://aistudio.google.com/apikey
OPENROUTER_API_KEY=                     # free ":free" models: https://openrouter.ai/keys
# PAID, best quality (switch once you have paying clients):
ANTHROPIC_API_KEY=                      # https://console.anthropic.com

# Optional overrides
AI_PROVIDER=                            # demo | groq | gemini | openrouter | ollama | anthropic | openai-compatible
AI_MODEL=                               # override the provider's default model (free model names change; check the provider's model list)
AI_BASE_URL=                            # for ollama on another host or a custom OpenAI-compatible endpoint
AI_TOOLS=                               # set to "off" if a free model errors on tool calling (leads are still captured)
LEADPILOT_EFFORT=low                    # Claude only: low | medium | high

# ---- Optional ----
PORT=3000
DATA_DIR=./data                         # where the SQLite database lives (use a persistent disk in production)
BRAND_NAME=LeadPilot AI                 # your agency's name on the landing page
HOUSE_BOT_ID=                           # a bot ID to run on your own landing page (dogfooding sells)
SALES_BOOKING_URL=                      # your Calendly link; inquiry form redirects here
STRIPE_LINK_STARTER=                    # Stripe Payment Links (no code needed), shown on the pricing buttons
STRIPE_LINK_GROWTH=
STRIPE_LINK_PRO=
