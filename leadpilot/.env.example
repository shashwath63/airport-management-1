# Copy to .env (or set these in your hosting dashboard)

# Required
ANTHROPIC_API_KEY=sk-ant-...            # https://console.anthropic.com
ADMIN_PASSWORD=change-me-to-something-long
PUBLIC_URL=https://your-domain.com      # used in embed codes and demo links

# Optional
PORT=3000
DATA_DIR=./data                         # where the SQLite database lives (use a persistent disk in production)
BRAND_NAME=LeadPilot AI                 # your agency's name on the landing page
HOUSE_BOT_ID=                           # a bot ID to run on your own landing page (dogfooding sells)
SALES_BOOKING_URL=                      # your Calendly link; inquiry form redirects here
STRIPE_LINK_STARTER=                    # Stripe Payment Links (no code needed), shown on the pricing buttons
STRIPE_LINK_GROWTH=
STRIPE_LINK_PRO=

# AI tuning
LEADPILOT_MODEL=claude-opus-5-5         # most capable; claude-haiku-5-5 is ~40x cheaper per token if you want max margin
LEADPILOT_EFFORT=low                    # low | medium | high
